class Node {
    int data;
    Node prev;
    Node next;

    Node(int data) {
        this.data = data;
        this.prev = null;
        this.next = null;
    }
}

class DL {
    private Node head;

    public void InsertAtBegin(int data) {
        Node newnode = new Node(data);

        if (head != null) {
            head.prev = newnode;
            newnode.next = head;
        }

        head = newnode;
    }

    public void display() {
        Node current = head;

        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }

        System.out.println("null");
    }

    public void backT() {
        if (head == null) {
            return;
        }

        Node current = head;

        while (current.next != null) {
            current = current.next;
        }

        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.prev;
        }

        System.out.println("null");
    }
}

public class Main {
    public static void main(String[] args) {
        DL list = new DL();

        list.InsertAtBegin(30);
        list.InsertAtBegin(20);
        list.InsertAtBegin(10);

        System.out.println("Forward Traversal:");
        list.display();

        System.out.println("Backward Traversal:");
        list.backT();
    }
}
